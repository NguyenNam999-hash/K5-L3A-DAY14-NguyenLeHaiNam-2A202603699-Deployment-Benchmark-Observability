# Copy: cp .env.example .env   (.env đã nằm trong .gitignore — KHÔNG commit)
# Không ghi secret thật vào file này.

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security — đặt giá trị thật qua biến môi trường / dashboard của platform
AGENT_API_KEY=change-me

# Storage (rate limit + cost guard)
REDIS_URL=redis://localhost:6379/0

# Rate limit & budget
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
